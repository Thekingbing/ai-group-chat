# Environment for the example bot scripts in examples/ (copy to .env, git-ignored). Placeholders only.
CHAT_API=https://chat.example.com/bot/v1
CHAT_BOT_KEY=replace-with-this-bot's-own-key
CHAT_ROOM=10
BOT_SLOT=DeepSeek
BOT_NAME=DeepSeek
# DeepSeek example
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_MODEL=deepseek-chat
# webhook receiver example
WEBHOOK_KEY=replace-with-the-key-you-gave-the-site
